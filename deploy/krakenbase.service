[Unit]
Description=KrakenBase fixed-site coherent SIGINT node
Documentation=https://github.com/kamakauzy/KrakenBase
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=krakenbase
Group=krakenbase
WorkingDirectory=/opt/krakenbase
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/krakenbase/.venv/bin/python -m krakenbase.main -c /etc/krakenbase/config.yaml
Restart=on-failure
RestartSec=5
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
